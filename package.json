{
  "name": "kakera-vault",
  "productName": "Kakera Vault",
  "version": "5.0.0",
  "description": "Kakera Vault: gestor de coleccion (harem) de Mudae para PC, version portable. Ordena, edita, genera comandos y comparte tu coleccion.",
  "author": "Kakera Vault",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "net.kakeravault.app",
    "productName": "Kakera Vault",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "style.css",
      "v5.css",
      "core.js",
      "app.js",
      "v5.js",
      "home.js",
      "icons/**/*",
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "KakeraVault-Portable-${version}.exe",
      "requestExecutionLevel": "user"
    },
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ],
    "compression": "maximum"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
